# --- Required for every setup ---------------------------------------------
OPSFLEET_ENV=local
OPSFLEET_GCP_PROJECT=your-gcp-project-id
OPSFLEET_PII_HASH_SALT=change-me-to-32-random-chars
# required whenever OPSFLEET_REDIS_URL is set (make up-full, production): openssl rand -hex 32
OPSFLEET_PII_VALUE_KEY=
GEMINI_API_KEY=

# free-tier uses Flash / Flash-Lite only; production adds Pro for analyst and writer
OPSFLEET_MODEL_PROFILE=free-tier
# dlp = local rules + Google Sensitive Data Protection (enable dlp.googleapis.com); regex = local rules only
OPSFLEET_PII_REDACTOR=dlp

# local Bifrost gateway; the virtual key below exists only in the local compose stack
OPSFLEET_LLM_BASE_URL=http://localhost:8080/v1
OPSFLEET_LLM_API_KEY=sk-bf-data-agent
BIFROST_VIRTUAL_KEY=sk-bf-data-agent

OPSFLEET_DATABASE_URL=postgresql+asyncpg://opsfleet:opsfleet@localhost:5433/opsfleet
POSTGRES_PASSWORD=opsfleet
POSTGRES_PORT=5433

OPSFLEET_METRICS_PORT=9464

# --- Optional: self-hosted Langfuse (make up-obs / make up-full) -----------
# Uncomment all OPSFLEET_LANGFUSE_* together (all or nothing) and fill the secrets.
# Generate values with: openssl rand -hex 32
# OPSFLEET_LANGFUSE_HOST=http://localhost:3300
# OPSFLEET_LANGFUSE_PUBLIC_KEY=pk-lf-opsfleet-local
# OPSFLEET_LANGFUSE_SECRET_KEY=sk-lf-opsfleet-local
# OPSFLEET_PROMPT_LABEL=production
# OPSFLEET_TRACE_URL=http://localhost:3300/project/data-agent/traces/{trace_id}
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_ADMIN_PASSWORD=

# --- Optional: full local stack (make up-full) -----------------------------
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DEMO_PASSWORD=
CHAINLIT_AUTH_SECRET=
