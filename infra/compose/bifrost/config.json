{
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "/app/data/config.db"
    }
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini",
          "value": "env.GEMINI_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "max_retries": 1,
        "retry_backoff_initial": 1000,
        "retry_backoff_max": 8000
      }
    }
  },
  "governance": {
    "budgets": [
      {
        "id": "budget-agent-daily",
        "virtual_key_id": "vk-agent",
        "max_limit": 5,
        "reset_duration": "1d"
      }
    ],
    "rate_limits": [
      {
        "id": "rl-agent",
        "request_max_limit": 120,
        "request_reset_duration": "1m",
        "token_max_limit": 2000000,
        "token_reset_duration": "1h"
      }
    ],
    "virtual_keys": [
      {
        "id": "vk-agent",
        "name": "data-agent",
        "value": "env.BIFROST_VIRTUAL_KEY",
        "is_active": true,
        "allow_all_providers": true,
        "calendar_aligned": true,
        "rate_limit_id": "rl-agent"
      }
    ]
  },
  "plugins": [
    {
      "enabled": true,
      "name": "otel",
      "config": {
        "service_name": "bifrost",
        "collector_url": "http://langfuse-web:3000/api/public/otel/v1/traces",
        "trace_type": "genai_extension",
        "protocol": "http",
        "headers": {
          "Authorization": "env.LANGFUSE_OTEL_AUTH"
        },
        "plugin_span_filter": {
          "mode": "exclude",
          "plugins": [
            "compat",
            "governance",
            "logging",
            "model-catalog-resolver",
            "otel",
            "prompts",
            "routing",
            "semantic_cache",
            "telemetry"
          ]
        }
      }
    }
  ]
}
